# .env next to compose.yaml (never committed) holds PUBLIC_FQDN and BACKEND_NOTIFY_URLS at least; copy a line from
# here to change anything else. The container gets all of .env.

# Hostname Traefik routes the page on, no scheme, no port, e.g. ovh.example.com. Required.
PUBLIC_FQDN=

# Whitespace-separated shoutrrr URLs. SMTP: port 587 is STARTTLS (465: add &encryption=ImplicitTLS); URL-encode
# special characters in the password (@ is %40); several recipients: to=a@x.ch,b@y.ch.
# A leading ! switches one channel off without deleting it: !smtp://… (restart to apply). "channel N" on the
# page counts the channels switched on, so the numbers shift when one is switched off.
# Test: docker compose run --rm ovh-restock -notify-test
BACKEND_NOTIFY_URLS=smtp://user:password@mail.example.com:587/?from=ovh@example.com&to=me@example.com

# Time zone of the page's dates (the image carries the zone data).
TZ=Europe/Zurich

# Optional LLM: stock patterns on the page, the Sunday digest, -wish. Without a model or key all three are off.
# The key's variable is llmwire's own (LLMWIRE_<PROVIDER>_API_KEY). Calls are capped per day; 0 makes none.
BACKEND_LLM_MODEL=glm-5.3-flash
LLMWIRE_ZAI_API_KEY=
BACKEND_LLM_DAILY_CALLS=100
# A wish in plain words → a want block: docker compose run --rm ovh-restock -wish "nvme, 64 GB, under 30 €"

# Listen address inside the container. The Traefik service port in compose.yaml is 8080: change both together.
BACKEND_ADDR=:8080
# Writable: app.db (SQLite, with its -wal and -shm files). Read-only: config.json (copy config.example.json).
BACKEND_DATA_DIR=/data
BACKEND_CONF_DIR=/conf
